# Configuración del servidor para Home - clases Portal
PORT=3000
NODE_ENV=development

# Claves de API de proveedores de IA para AI Studio (Backend server-side únicamente)
# AI Studio o el servidor Express leerán estas variables de entorno en el servidor.
# NUNCA expongas estas claves en el frontend ni en archivos públicos.

# Google Gemini API Key
GEMINI_API_KEY=""

# Groq API Key (ultra rápido Llama 3)
GROQ_API_KEY=""

# OpenAI API Key (GPT-4o, GPT-4o-mini)
OPENAI_API_KEY=""

# Mistral AI Key (Mistral Small, Mistral Large, Codestral)
MISTRAL_API_KEY=""

# OpenRouter API Key (DeepSeek, Claude, Llama y otros)
OPENROUTER_API_KEY=""

# NVIDIA NIM API Key (Llama 3.1 70B / 405B en NVIDIA Cloud)
NVIDIA_API_KEY=""

# Hugging Face API Token (Modelos open source)
HUGGINGFACE_API_KEY=""
